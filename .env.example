# Required: LocalStack needs an auth token to start, and Cognito is only
# included in paid plans (the free Hobby plan does not include it).
# Get your token at https://app.localstack.cloud/workspace/auth-token
LOCALSTACK_AUTH_TOKEN=

# Optional
# LOCALSTACK_IMAGE=localstack/localstack:2026.08
# LOCALSTACK_DEBUG=1
# LAMBDA_CONCURRENCY=20
