      ]
    },
    {
      "name": "LocalStack mailbox",
      "item": [
        {
          "name": "Read the magic link from LocalStack SES",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{localstackUrl}}/_aws/ses"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const email = pm.collectionVariables.get(\"email\");",
                  "const latest = pm.response.json().messages",
                  "  .filter((m) => m.Destination.ToAddresses.includes(email))",
                  "  .sort((a, b) => Date.parse(a.Timestamp) - Date.parse(b.Timestamp))",
                  "  .at(-1);",
                  "const link = latest && latest.Body.text_part.match(/https?:\\/\\/\\S+token=[0-9a-f]{64}/);",
                  "pm.test(\"an email with a magic link was captured\", () => pm.expect(link).to.be.an(\"array\"));",
                  "pm.test(\"the cooldown sent a single email for two requests\", () => pm.expect(pm.response.json().messages.filter((m) => m.Destination.ToAddresses.includes(email))).to.have.lengthOf(1));",
                  "const [, path, token] = link[0].match(/^https?:\\/\\/[^/]+(\\/[^?]*)\\?.*token=([0-9a-f]{64})/);",
                  "pm.test(\"the link points to the frontend callback\", () => pm.expect(path).to.eql(\"/auth/callback\"));",
                  "pm.collectionVariables.set(\"token\", token);"
                ]
              }
            }
          ]
        }
      ]
    },
