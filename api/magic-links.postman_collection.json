        {
          "name": "202 - sends a magic link",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{apiUrl}}/login",
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"{{email}}\"}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"email\", `api-${Date.now()}@example.com`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"returns 202\", () => pm.response.to.have.status(202));",
                  "pm.test(\"is never cached\", () => pm.expect(pm.response.headers.get(\"Cache-Control\")).to.eql(\"no-store\"));",
                  "pm.test(\"gives the same answer for every email (no enumeration)\", () => {",
                  "  pm.expect(pm.response.json()).to.eql({ message: \"If the email address is valid, a magic link is on its way.\" });",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "202 - same response inside the cooldown (no email sent)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{apiUrl}}/login",
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"{{email}}\"}"
